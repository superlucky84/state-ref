{
  "type": "module",
  "name": "state-ref",
  "version": "3.0.2",
  "private": false,
  "description": "Universal state management library that can be easily integrated into UI libraries",
  "packageManager": "pnpm@7.6.0",
  "main": "./dist/state-ref.cjs",
  "module": "./dist/state-ref.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.plugin.config.js && vite build --config vite.draft.config.js && vite build --config vite.batch.config.js",
    "watch": "vite build --watch",
    "test": "vitest run --reporter verbose",
    "test:dev": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/state-ref.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/state-ref.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin.mjs"
      }
    },
    "./draft": {
      "import": {
        "types": "./dist/draft/index.d.ts",
        "default": "./dist/state-ref.draft.mjs"
      },
      "require": {
        "types": "./dist/draft/index.d.cts",
        "default": "./dist/state-ref.draft.cjs"
      }
    },
    "./batch": {
      "import": {
        "types": "./dist/batch/index.d.ts",
        "default": "./dist/state-ref.batch.mjs"
      },
      "require": {
        "types": "./dist/batch/index.d.cts",
        "default": "./dist/state-ref.batch.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "batch": [
        "dist/batch/index.d.ts"
      ]
    }
  },
  "files": [
    "src",
    "!src/tests",
    "dist",
    "dist/skills",
    "dist/ai-addons"
  ],
  "author": "superlucky84",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/state-ref.git"
  },
  "homepage": "https://github.com/superlucky84/state-ref",
  "license": "MIT",
  "keywords": [
    "state-ref"
  ],
  "volta": {
    "node": "20.3.0"
  }
}
