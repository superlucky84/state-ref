{
  "type": "module",
  "name": "@stateref/connect-react",
  "version": "19.0.0",
  "private": false,
  "description": "React connector for state-ref",
  "packageManager": "pnpm@7.6.0",
  "main": "./dist/stateref-connect-react.cjs",
  "module": "./dist/stateref-connect-react.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --reporter verbose",
    "test:dev": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/stateref-connect-react.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/stateref-connect-react.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "!src/tests",
    "dist"
  ],
  "author": "superlucky84",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/state-ref.git"
  },
  "homepage": "https://github.com/superlucky84/state-ref",
  "license": "MIT",
  "keywords": [
    "state-ref"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "state-ref": "^3.1.0"
  },
  "devDependencies": {
    "@stateref/sync": "workspace:^",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "state-ref": "workspace:*"
  },
  "volta": {
    "node": "20.3.0"
  }
}
