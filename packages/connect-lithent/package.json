{
  "type": "module",
  "name": "@stateref/connect-lithent",
  "version": "0.1.0",
  "private": false,
  "description": "Lithent query view connector for state-ref",
  "module": "./dist/stateref-connect-lithent.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/stateref-connect-lithent.mjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync.d.ts",
        "default": "./dist/stateref-connect-lithent.sync.mjs"
      }
    }
  },
  "files": [
    "src",
    "!src/tests",
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.sync.config.js",
    "test": "vitest run --reporter verbose",
    "test:ssr": "vitest run --config vite.ssr.config.js --reporter verbose"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/state-ref.git"
  },
  "peerDependencies": {
    "lithent": "^1.24.0",
    "state-ref": "^3.1.0",
    "@stateref/sync": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@stateref/sync": {
      "optional": true
    }
  },
  "devDependencies": {
    "lithent": "1.24.0",
    "lithent-concurrent": "0.1.3",
    "state-ref": "workspace:*",
    "@stateref/sync": "workspace:^"
  }
}
