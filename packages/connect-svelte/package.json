{
  "type": "module",
  "name": "@stateref/connect-svelte",
  "version": "4.3.0",
  "private": false,
  "description": "Svelte connector for state-ref",
  "packageManager": "pnpm@7.6.0",
  "main": "./dist/stateref-connect-svelte.cjs",
  "module": "./dist/stateref-connect-svelte.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --reporter verbose",
    "test:dev": "vitest",
    "test:ssr": "vitest run --config vite.ssr.config.js --reporter verbose"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/stateref-connect-svelte.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/stateref-connect-svelte.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "author": "superlucky84",
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/state-ref.git"
  },
  "homepage": "https://github.com/superlucky84/state-ref",
  "license": "MIT",
  "keywords": [
    "state-ref"
  ],
  "peerDependencies": {
    "state-ref": "^3.0.0",
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "@stateref/sync": "workspace:^",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^5.2.3",
    "state-ref": "workspace:*",
    "svelte": "^4.2.19"
  },
  "volta": {
    "node": "20.3.0"
  }
}
